# Every variable the application actually reads, and nothing else.
#
# Verified against the source with:
#   grep -rhoE "process\.env\.[A-Z_0-9]+" src/ | sort -u
#
# NOTE: the working .env additionally contains SUPABASE_JWT_SECRET,
# GOOGLE_CLIENT_SECRET and NEXTAUTH_SECRET. Nothing in src/ reads any of
# them - they are leftovers from the NextAuth setup this app replaced with
# Supabase Auth. Delete them from .env and rotate them at the provider:
# an unused credential is one nobody notices leaking.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# The ANON/publishable key. Reaches the browser by design.
NEXT_PUBLIC_SUPABASE_KEY=
# Server-only. Bypasses row level security - never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Base URLs
# Origin of this deployment, e.g. https://daaist.com
# Used for invite links and event check-in QR codes. When unset, both fall
# back to the request headers, so set it in production.
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_TOOLS_API_BASE_URL=
TOOLS_API_BASE_URL=

# Cloudflare R2 (S3-compatible file storage)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET_NAME=
# Public custom domain the bucket is served from, e.g. https://cdn.daaist.com
# No trailing slash. Object keys are appended to it directly.
R2_PUBLIC_DOMAIN=
